{
  // Type-checks the test suites without emitting them: `include` of the base config
  // deliberately leaves `test/**` out, so the published `dist` never carries test code.
  // Closes D-25, where the suites were not type-checked at all.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["test/**/*"]
}
