{
  "name": "@volcanicminds/backend",
  "version": "5.0.0-alpha.0",
  "type": "module",
  "codename": "rome",
  "license": "MIT",
  "description": "Volcanic (minds) backend",
  "keywords": [
    "volcanic",
    "open source",
    "api",
    "framework",
    "backend",
    "http",
    "https",
    "fastify",
    "swagger",
    "helmet",
    "json",
    "typescript",
    "javascript",
    "rest",
    "restful",
    "pino",
    "rate limit",
    "jest"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "node scripts/copy-assets.mjs",
    "preprod": "npm run build",
    "prod": "cd dist && node server.js",
    "start": "tsx --env-file .env server.ts",
    "dev": "tsx watch --env-file .env server.ts",
    "prepublishOnly": "npm run check-all && npm test",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:e2e:mt:pg": "cross-env NODE_ENV=test PORT=2241 LOG_LEVEL=silent DB_POOL_MAX=1 AUTH_RATELIMIT_MAX=100000 ADMIN_EMAIL=super@system.test ADMIN_PASSWORD=Super-pw-123456 JWT_SECRET=e2e-test-secret-please-change-32-chars JWT_REFRESH_SECRET=e2e-refresh-secret-please-change-32ch MFA_DB_SECRET=unit-test-secret-please-change-32xyz mocha --import=tsx ./test/e2e-mt-pg/**/*.e2e.spec.ts -t 60000 --exit",
    "test:lib": "cross-env NODE_ENV=memory mocha --import=tsx ./test/lib/**/*.spec.ts -t 20000 --exit",
    "reset": "npm install && npm update && npm run build",
    "upgrade-deps": "npx npm-check-updates -u",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "depcruise": "depcruise index.ts lib --config .dependency-cruiser.cjs",
    "check-all": "npm run lint && npm run type-check && npm run depcruise",
    "combine": "node combine.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/schedule": "^6.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-raw-body": "^5.0.0",
    "glob": "^13.0.0",
    "i18n": "^0.15.3",
    "lodash": "^4.17.21",
    "nanoid": "^5.1.6",
    "object-sizeof": "^2.6.5",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "root-require": "^0.3.1",
    "semver": "^7.7.3",
    "toad-scheduler": "^3.1.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@electric-sql/pglite-pgvector": "^0.0.4",
    "@libsql/client": "^0.18.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-pgvector": {
      "optional": true
    },
    "bcrypt": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@electric-sql/pglite-pgvector": "^0.0.4",
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.11.10",
    "@types/semver": "^7.7.1",
    "autocannon": "^8.0.0",
    "bcrypt": "^6.0.0",
    "cross-env": "^10.1.0",
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^12.11.1",
    "dependency-cruiser": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.2",
    "expect": "^30.2.0",
    "globals": "^16.5.0",
    "mocha": "^8.1.3",
    "pg": "^8.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcanicminds/volcanic-backend.git"
  },
  "homepage": "https://volcanicminds.com",
  "bugs": {
    "url": "https://github.com/volcanicminds/volcanic-backend/issues"
  },
  "author": "Volcanic Minds <developers@volcanicminds.com> (https://volcanicminds.com)",
  "maintainers": [
    "Developers <developers@volcanicminds.com> (https://volcanicminds.com)"
  ],
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "engines": {
    "node": ">=24"
  }
}
